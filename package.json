{
  "name": "emargy-mail",
  "version": "0.6.1",
  "description": "Open-source, local-first email client for multiple projects and accounts.",
  "main": "electron/main.cjs",
  "author": "Emargy contributors",
  "license": "AGPL-3.0-only",
  "private": false,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:app": "npm run build && node scripts/e2e-app.cjs",
    "demo:server": "node scripts/demo-mail-server.cjs",
    "dist:win": "npm run test && npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.emargy.mail",
    "productName": "Emargy Mail",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Emargy-Mail-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Emargy-Mail-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Emargy-Mail-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "imapflow": "^2.11.0",
    "mailauth": "8.0.6",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dompurify": "^3.4.18",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "hoodiecrow-imap": "^3.3.1",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.73.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
